@model IEnumerable<petti.Models.ViewModels.ProductCardViewModel>
@using petti.Models
@{
    ViewData["Title"] = "Shop Pet Essentials";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<header class="page-header">
    <div class="container-petti">
        <div class="breadcrumb-petti">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <i class="fa-solid fa-chevron-right" style="font-size:0.65rem;"></i>
            <span>Shop</span>
        </div>
        <h1>Shop Pet Essentials</h1>
        <p style="margin:0; color:var(--ink-soft);">Food, toys, hygiene and health items ,delivered alongside your next home visit.</p>
    </div>
</header>

<section class="section-tight">
    <div class="container-petti">
        <div class="row g-4">

            <!-- Sidebar filters -->
            <aside class="col-lg-3">
                <div class="filter-sidebar">

                    <div class="filter-block">
                        <div class="filter-block-title">Pet type</div>
                        <div class="pet-toggle-row">
                            <button class="pet-toggle active" data-pet-filter="all">All</button>
                            <button class="pet-toggle" data-pet-filter="dog"><i class="fa-solid fa-dog"></i> Dog</button>
                            <button class="pet-toggle" data-pet-filter="cat"><i class="fa-solid fa-cat"></i> Cat</button>
                        </div>
                    </div>

                    <div class="filter-block">
                        <div class="filter-block-title">Category</div>
                        @if (!categories.Any())
                        {
                            <label class="check-row"><input type="checkbox" class="cat-checkbox" value="food" checked> Food</label>
                            <label class="check-row"><input type="checkbox" class="cat-checkbox" value="toys" checked> Toys</label>
                            <label class="check-row"><input type="checkbox" class="cat-checkbox" value="hygiene" checked> Hygiene</label>
                            <label class="check-row"><input type="checkbox" class="cat-checkbox" value="health" checked> Health</label>
                        }
                        else
                        {
                            @foreach (var cat in categories)
                            {
                                <label class="check-row">
                                    <input type="checkbox" class="cat-checkbox" value="@cat.Name.ToLower()" checked> @cat.Name
                                </label>
                            }
                        }
                    </div>

                    <div class="filter-block">
                        <div class="filter-block-title">Price range (JOD)</div>
                        <input type="range" class="range-slider" id="priceRange" min="0" max="100" value="100">
                        <div class="range-values"><span>0</span><span id="priceRangeValue">100</span></div>
                    </div>

                    <div class="filter-block">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="filter-block-title" style="margin:0;">In-Stock Only</span>
                            <label class="toggle-switch">
                                <input type="checkbox" id="inStockOnly">
                                <span class="toggle-slider"></span>
                            </label>
                        </div>
                    </div>

                </div>
            </aside>

            <!-- Product grid -->
            <div class="col-lg-9">

                <div class="catalog-topbar">
                    <div class="catalog-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="catalogSearch" placeholder="Search products...">
                    </div>
                    <span class="result-count" id="resultCount">@Model.Count() products</span>
                    <select class="sort-select" id="sortSelect">
                        <option value="newest">Newest</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="rating">Top Rated</option>
                    </select>
                </div>

                <div class="row g-4" id="productsGrid">
                    @foreach (var p in Model)
                    {
                        <div class="col-sm-6 col-lg-4 product-col"
                             data-id="@p.ProductId"
                             data-name="@p.Name.ToLower()"
                             data-category="@p.CategoryName.ToLower()"
                             data-pet="@p.TargetPetType?.ToLower()"
                             data-price="@p.Price"
                             data-stock="@(p.StockQuantity > 0 ? "in" : "out")"
                             data-rating="@p.AverageRating">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card" style="background:#fff;">
                                <div class="position-relative text-center p-3" style="background: #FAF9F6;">
                                    <img src="@p.ImageUrl" alt="@p.Name" class="img-fluid" style="height: 180px; object-fit: contain;">
                                    <span class="badge position-absolute top-0 start-0 m-3 bg-white text-dark shadow-sm rounded-pill px-2 py-1 small">
                                        @p.CategoryName
                                    </span>
                                </div>

                                <div class="card-body d-flex flex-column p-3">
                                    <div class="d-flex align-items-center gap-1 small text-warning mb-1">
                                        <i class="fa-solid fa-star"></i>
                                        <span class="text-dark fw-bold">@p.AverageRating.ToString("0.0")</span>
                                        <span class="text-muted">(@p.ReviewsCount)</span>
                                    </div>

                                    <h3 class="h6 card-title mb-1 text-truncate" title="@p.Name">@p.Name</h3>
                                    <p class="text-muted small text-truncate-2 mb-3" style="min-height: 38px;">@p.Description</p>

                                    <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                                        <span class="fw-bold fs-5 text-berry">@p.Price.ToString("0.00") <small class="fs-6 text-muted">JOD</small></span>
                                        <button class="btn-petti btn-berry btn-sm add-to-cart-btn"
                                                data-id="@p.ProductId"
                                                data-name="@p.Name"
                                                data-price="@p.Price"
                                                data-img="@p.ImageUrl">
                                            <i class="fa-solid fa-cart-plus"></i> Add
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="empty-state" id="emptyState" style="display:none; text-align: center; padding: 4rem 1rem;">
                    <i class="fa-solid fa-magnifying-glass" style="font-size: 2.5rem; color: #9AA2B3; margin-bottom: 1rem;"></i>
                    <h3>No products match your filters</h3>
                    <p style="margin:0; color: #667085;">Try widening your price range or clearing a category.</p>
                </div>

            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        function currentFilters() {
            const activePet = document.querySelector('.pet-toggle.active')?.dataset.petFilter || 'all';
            const activeCats = Array.from(document.querySelectorAll('.cat-checkbox:checked')).map(c => c.value.toLowerCase());
            const maxPrice = Number(document.getElementById('priceRange').value);
            const inStockOnly = document.getElementById('inStockOnly').checked;
            const search = document.getElementById('catalogSearch').value.trim().toLowerCase();
            const sort = document.getElementById('sortSelect').value;
            return { activePet, activeCats, maxPrice, inStockOnly, search, sort };
        }

        function renderCatalog() {
            const { activePet, activeCats, maxPrice, inStockOnly, search, sort } = currentFilters();
            const items = Array.from(document.querySelectorAll('.product-col'));
            let visibleCount = 0;

            items.forEach(el => {
                const pet = el.dataset.pet;
                const category = el.dataset.category;
                const price = parseFloat(el.dataset.price);
                const stock = el.dataset.stock;
                const name = el.dataset.name;

                let matches = true;
                if (activePet !== 'all' && pet !== activePet && pet !== 'all') matches = false;
                if (activeCats.length > 0 && !activeCats.includes(category)) matches = false;
                if (price > maxPrice) matches = false;
                if (inStockOnly && stock !== 'in') matches = false;
                if (search && !name.includes(search)) matches = false;

                if (matches) {
                    el.style.display = '';
                    visibleCount++;
                } else {
                    el.style.display = 'none';
                }
            });

            // Sorting
            const grid = document.getElementById('productsGrid');
            const sortedItems = items.filter(el => el.style.display !== 'none');

            if (sort === 'price-asc') {
                sortedItems.sort((a, b) => parseFloat(a.dataset.price) - parseFloat(b.dataset.price));
            } else if (sort === 'price-desc') {
                sortedItems.sort((a, b) => parseFloat(b.dataset.price) - parseFloat(a.dataset.price));
            } else if (sort === 'rating') {
                sortedItems.sort((a, b) => parseFloat(b.dataset.rating) - parseFloat(a.dataset.rating));
            }

            sortedItems.forEach(node => grid.appendChild(node));

            document.getElementById('resultCount').textContent = `${visibleCount} product${visibleCount === 1 ? '' : 's'}`;
            document.getElementById('emptyState').style.display = visibleCount === 0 ? 'block' : 'none';
        }

        document.addEventListener('DOMContentLoaded', renderCatalog);

        document.addEventListener('click', (e) => {
            const petBtn = e.target.closest('.pet-toggle');
            if (petBtn) {
                document.querySelectorAll('.pet-toggle').forEach(b => b.classList.remove('active'));
                petBtn.classList.add('active');
                renderCatalog();
            }
        });

        document.addEventListener('change', (e) => {
            if (e.target.matches('.cat-checkbox, #inStockOnly, #sortSelect')) renderCatalog();
            if (e.target.id === 'priceRange') {
                document.getElementById('priceRangeValue').textContent = e.target.value;
                renderCatalog();
            }
        });

        document.addEventListener('input', (e) => {
            if (e.target.id === 'catalogSearch') renderCatalog();
        });
    </script>
}