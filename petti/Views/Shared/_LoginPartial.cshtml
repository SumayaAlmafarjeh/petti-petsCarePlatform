@using Microsoft.AspNetCore.Identity
@using petti.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-2 m-0 p-0">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-dark fw-bold" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                <i class="fa-solid fa-circle-user text-berry me-1"></i> Hello, @User.Identity?.Name!
            </a>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                <button type="submit" class="btn-petti btn-ink-outline btn-sm">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn-petti btn-ink-outline btn-sm d-none d-md-inline-flex" asp-area="Identity" asp-page="/Account/Login">Sign In</a>
        </li>
        <li class="nav-item">
            <a class="btn-petti btn-berry btn-sm d-none d-md-inline-flex text-white text-decoration-none" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
    }
</ul>