<!-- =========================================================
     BOOKING MODAL
     ========================================================= -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content petti-modal">

            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <span class="service-card-icon" id="modalServiceIcon" style="width:48px;height:48px;font-size:1.1rem;margin-bottom:0;"></span>
                    <div>
                        <div class="modal-service-name" id="modalServiceName">Service</div>
                        <div style="font-size:0.82rem;color:var(--ink-faint);">Fixed price: <span id="modalServicePrice" class="text-berry" style="font-weight:700;"></span></div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">

                <label class="form-label-petti">Choose a time slot</label>
                <div class="slot-grid">
                    <button type="button" class="slot-btn selected">9:00 AM</button>
                    <button type="button" class="slot-btn">11:30 AM</button>
                    <button type="button" class="slot-btn">1:00 PM</button>
