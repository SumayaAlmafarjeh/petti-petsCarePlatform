@model IEnumerable<petti.Models.Booking>
@{
    ViewData["Title"] = "My Appointments — Petti";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header class="page-header">
    <div class="container-petti">
        <div class="breadcrumb-petti">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <i class="fa-solid fa-chevron-right" style="font-size:0.65rem;"></i>
            <span>My Appointments</span>
        </div>
        <h1>My Appointments</h1>
    </div>
</header>

<section class="section-tight">
    <div class="container-petti" style="max-width:820px;">

        <div class="portal-tabs">
            <button type="button" class="active" data-appt-tab="upcoming">Upcoming</button>
            <button type="button" data-appt-tab="past">Past</button>
        </div>

        <div id="apptList" class="d-flex flex-column gap-3">
            @foreach (var appt in Model)
            {
                var isPast = appt.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase) ||
                             appt.Status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase) ||
                             appt.AppointmentDate < DateTime.Today;

                <div class="card border-0 shadow-sm rounded-4 p-4 appt-card"
                     data-tab="@(isPast ? "past" : "upcoming")"
                     style="background:#fff;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-light text-berry" style="width:44px;height:44px;font-size:1.2rem;">
                                <i class="fa-solid fa-calendar-check"></i>
                            </span>
                            <div>
                                <h3 class="h6 mb-0 fw-bold">@appt.Service.Name</h3>
                                <span class="small text-muted">Pet: <strong>@appt.PetName</strong> (@appt.PetType)</span>
                            </div>
                        </div>
                        <div>
                            @if (appt.Status == "Confirmed")
                            {
                                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                    <i class="fa-solid fa-circle-check me-1"></i> Confirmed
                                </span>
                            }
                            else if (appt.Status == "Pending")
                            {
                                <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                                    <i class="fa-solid fa-clock me-1"></i> Scheduled
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-secondary-subtle text-secondary border px-3 py-2">
                                    @appt.Status
                                </span>
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 text-muted small">
                        <div>
                            <i class="fa-regular fa-clock me-1"></i> @appt.AppointmentDate.ToString("MMM dd, yyyy") — @appt.TimeSlot
                        </div>
                        <div class="fw-bold text-berry fs-6">
                            @appt.TotalPrice.ToString("0.00") JOD
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="empty-state" id="apptEmpty" style="display:none; text-align:center; padding:4rem 1rem;">
            <i class="fa-solid fa-calendar-xmark" style="font-size:2.5rem; color:#9AA2B3; margin-bottom:1rem;"></i>
            <h3>No appointments here</h3>
            <p style="margin-bottom:1.2rem; color:#667085;">Book a home visit whenever you're ready.</p>
            <a asp-controller="Services" asp-action="Index" class="btn-petti btn-berry">Browse Services</a>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        let activeApptTab = 'upcoming';

        function filterAppointments() {
            const cards = document.querySelectorAll('.appt-card');
            let visibleCount = 0;

            cards.forEach(card => {
                if (card.dataset.tab === activeApptTab) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('apptEmpty').style.display = visibleCount === 0 ? 'block' : 'none';
        }

        document.querySelectorAll('[data-appt-tab]').forEach(tabBtn => {
            tabBtn.addEventListener('click', () => {
                document.querySelectorAll('[data-appt-tab]').forEach(b => b.classList.remove('active'));
                tabBtn.classList.add('active');
                activeApptTab = tabBtn.dataset.apptTab;
                filterAppointments();
            });
        });

        filterAppointments();
    </script>
}