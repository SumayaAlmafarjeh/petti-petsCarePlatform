@model petti.Models.ViewModels.BookingWizardViewModel
@{
    ViewData["Title"] = $"Book {Model.ServiceName}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section" style="padding-top:7.5rem; padding-bottom:4rem;">
    <!-- توسيط الصفحة بالكامل عبر تحديد max-width و mx-auto -->
    <div class="container-petti" style="max-width: 680px; margin-left: auto; margin-right: auto;">

        <div class="breadcrumb-petti text-center justify-content-center mb-3">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <i class="fa-solid fa-chevron-right" style="font-size:0.65rem;"></i>
            <a asp-action="Index">Home Care</a>
            <i class="fa-solid fa-chevron-right" style="font-size:0.65rem;"></i>
            <span>Book</span>
        </div>

        <h1 class="text-center fw-bold" style="margin-bottom:1.8rem;">Book: @Model.ServiceName</h1>

        <!-- Wizard Steps Dots -->
        <div class="wizard-steps justify-content-center mb-4" id="wizardSteps">
            <div class="wizard-step active" data-step="1"><span class="wizard-step-dot">1</span><span class="wizard-step-label">Pet Info</span></div>
            <div class="wizard-step" data-step="2"><span class="wizard-step-dot">2</span><span class="wizard-step-label">Date &amp; Time</span></div>
            <div class="wizard-step" data-step="3"><span class="wizard-step-dot">3</span><span class="wizard-step-label">Address</span></div>
            <div class="wizard-step" data-step="4"><span class="wizard-step-dot">4</span><span class="wizard-step-label">Confirm</span></div>
        </div>

        <form asp-action="Book" method="post" id="bookingForm" class="shadow-sm rounded-4 p-4 border bg-white" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ServiceId" />
            <input type="hidden" asp-for="ServiceName" />
            <input type="hidden" asp-for="ServicePrice" />
            <input type="hidden" asp-for="PetType" id="hiddenPetType" value="@(string.IsNullOrEmpty(Model.PetType) ? "Dog" : Model.PetType)" />
            <input type="hidden" asp-for="TimeSlot" id="hiddenTimeSlot" value="@(string.IsNullOrEmpty(Model.TimeSlot) ? "09:00 – 11:00 AM" : Model.TimeSlot)" />
            <input type="hidden" asp-for="AppointmentDate" id="hiddenAppointmentDate" value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" />

            <!-- Step 1: Pet Information -->
            <div class="wizard-panel wizard-page" data-page="1">
                <h3 style="margin-bottom:1.2rem; font-weight:700;">Tell us about your pet</h3>

                <div class="pet-type-pick d-flex gap-3 mb-3">
                    <div class="pet-type-card flex-fill text-center p-3 border rounded-3 @(Model.PetType != "Cat" ? "selected" : "")" data-pet="Dog" style="cursor:pointer;">
                        <i class="fa-solid fa-dog fs-4 d-block mb-1"></i> Dog
                    </div>
                    <div class="pet-type-card flex-fill text-center p-3 border rounded-3 @(Model.PetType == "Cat" ? "selected" : "")" data-pet="Cat" style="cursor:pointer;">
                        <i class="fa-solid fa-cat fs-4 d-block mb-1"></i> Cat
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label-petti">Pet name</label>
                        <input asp-for="PetName" class="form-control-petti" id="inputPetName" placeholder="e.g. Milo" />
                        <span class="text-danger small" id="petNameError" style="display:none;">Please enter your pet's name.</span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti">Breed</label>
                        <input asp-for="Breed" class="form-control-petti" placeholder="e.g. Golden Retriever" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti">Age (years)</label>
                        <input asp-for="Age" type="number" min="0" class="form-control-petti" placeholder="3" />
                    </div>
                </div>

                <label class="form-label-petti">Behavioral / medical notes (optional)</label>
                <textarea asp-for="BehavioralNotes" class="form-control-petti" rows="2" placeholder="e.g. Nervous around clippers, sensitive paws"></textarea>

                <div class="wizard-nav d-flex justify-content-end mt-4">
                    <button type="button" class="btn-petti btn-berry next-step">Continue <i class="fa-solid fa-arrow-right ms-1"></i></button>
                </div>
            </div>

            <!-- Step 2: Date & Time -->
            <div class="wizard-panel wizard-page" data-page="2" style="display:none;">
                <h3 style="margin-bottom:1.2rem; font-weight:700;">Pick a date &amp; time slot</h3>

                <div class="mb-4">
                    <label class="form-label-petti">Select Date</label>
                    <input type="date" class="form-control-petti" id="datePicker"
                           value="@Model.AppointmentDate.ToString("yyyy-MM-dd")"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" style="max-width:280px;" />
                </div>

                <label class="form-label-petti">Available time slots</label>
                <div class="slot-grid d-flex gap-2 flex-wrap mb-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary slot-btn selected">09:00 – 11:00 AM</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary slot-btn">11:30 – 1:30 PM</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary slot-btn">3:00 – 5:00 PM</button>
                </div>

                <div class="wizard-nav d-flex justify-content-between mt-4">
                    <button type="button" class="btn-petti btn-ink-outline prev-step"><i class="fa-solid fa-arrow-left me-1"></i> Back</button>
                    <button type="button" class="btn-petti btn-berry next-step">Continue <i class="fa-solid fa-arrow-right ms-1"></i></button>
                </div>
            </div>

            <!-- Step 3: Address -->
            <div class="wizard-panel wizard-page" data-page="3" style="display:none;">
                <h3 style="margin-bottom:1.2rem; font-weight:700;">Where should we visit?</h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-petti">Amman Area / Neighborhood</label>
                        <input asp-for="Area" class="form-control-petti" id="inputArea" placeholder="e.g. Abdoun, Dabouq" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti">Contact Phone</label>
                        <input asp-for="ContactPhone" class="form-control-petti" id="inputPhone" placeholder="079 123 4567" />
                        <span class="text-danger small" id="phoneError" style="display:none;">Please enter a contact number.</span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti">Street address</label>
                        <input asp-for="StreetAddress" class="form-control-petti" id="inputStreet" placeholder="e.g. Rainbow St." />
                        <span class="text-danger small" id="streetError" style="display:none;">Please enter your street address.</span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti">Building &amp; Apartment notes</label>
                        <input asp-for="BuildingDetails" class="form-control-petti" id="inputBuilding" placeholder="Bldg 14, Apt 3" />
                    </div>
                </div>
                <div class="wizard-nav d-flex justify-content-between mt-4">
                    <button type="button" class="btn-petti btn-ink-outline prev-step"><i class="fa-solid fa-arrow-left me-1"></i> Back</button>
                    <button type="button" class="btn-petti btn-berry next-step">Continue <i class="fa-solid fa-arrow-right ms-1"></i></button>
                </div>
            </div>

            <!-- Step 4: Summary & Confirmation -->
            <div class="wizard-panel wizard-page" data-page="4" style="display:none;">
                <h3 style="margin-bottom:1.2rem; font-weight:700;">Review &amp; confirm</h3>

                <div class="d-flex justify-content-between py-2 border-bottom"><span>Service</span><strong>@Model.ServiceName</strong></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span>Pet</span><strong id="sumPet">@Model.PetName (@Model.PetType)</strong></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span>Date &amp; time</span><strong id="sumSlot">@Model.AppointmentDate.ToString("yyyy-MM-dd") — @Model.TimeSlot</strong></div>
                <div class="d-flex justify-content-between py-2 border-bottom"><span>Address</span><strong id="sumAddress">@Model.Area, Amman</strong></div>

                <label class="form-label-petti mt-3">Caregiver checklist</label>
                <ul class="list-unstyled mb-3">
                    <li class="mb-1"><i class="fa-solid fa-circle-check text-success me-2"></i> ID-verified specialist dispatched to your address</li>
                    <li class="mb-1"><i class="fa-solid fa-circle-check text-success me-2"></i> All grooming tools sanitized before your visit</li>
                    <li class="mb-1"><i class="fa-solid fa-circle-check text-success me-2"></i> Live status updates from booking to completion</li>
                </ul>

                <div class="d-flex justify-content-between py-3 border-top mt-2" style="font-size:1.15rem;">
                    <span>Total service fee</span>
                    <span class="text-berry fw-bold">@Model.ServicePrice.ToString("0.00") JOD</span>
                </div>

                <div class="wizard-nav d-flex justify-content-between mt-4">
                    <button type="button" class="btn-petti btn-ink-outline prev-step"><i class="fa-solid fa-arrow-left me-1"></i> Back</button>
                    <button type="button" class="btn-petti btn-berry px-4" id="submitBookingBtn">
                        Confirm Booking <i class="fa-solid fa-check ms-1"></i>
                    </button>
                </div>
            </div>
        </form>

    </div>
</section>

@section Scripts {
    <script>
        let currentStep = 1;

        function syncSummary() {
            const petName = document.getElementById('inputPetName').value.trim() || 'My Pet';
            const petType = document.getElementById('hiddenPetType').value;
            document.getElementById('sumPet').textContent = `${petName} (${petType})`;

            const dateVal = document.getElementById('datePicker').value;
            const slotVal = document.getElementById('hiddenTimeSlot').value;
            document.getElementById('hiddenAppointmentDate').value = dateVal;
            document.getElementById('sumSlot').textContent = `${dateVal} — ${slotVal}`;

            const area = document.getElementById('inputArea').value.trim() || 'Amman';
            const street = document.getElementById('inputStreet').value.trim();
            document.getElementById('sumAddress').textContent = street ? `${street}, ${area}` : area;
        }

        function goToStep(step) {
            syncSummary();
            currentStep = step;
            document.querySelectorAll('.wizard-page').forEach(p => p.style.display = Number(p.dataset.page) === step ? 'block' : 'none');
            document.querySelectorAll('.wizard-step').forEach(s => {
                const n = Number(s.dataset.step);
                s.classList.toggle('active', n === step);
                s.classList.toggle('done', n < step);
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        document.addEventListener('click', (e) => {
            // Next
            if (e.target.closest('.next-step')) {
                        if (currentStep === 1) {
                    const name = document.getElementById('inputPetName').value.trim();
                    if (!name) {
                        document.getElementById('petNameError').style.display = 'block';
                        return;
                    }
                    document.getElementById('petNameError').style.display = 'none';
                        }
                if (currentStep === 3) {
                    const street = document.getElementById('inputStreet').value.trim();
                    const phone = document.getElementById('inputPhone').value.trim();
                    let hasErr = false;

                    if (!street) {
                        document.getElementById('streetError').style.display = 'block';
                                hasErr = true;
                    } else {
                        document.getElementById('streetError').style.display = 'none';
                    }

                            if (!phone) {
                                document.getElementById('phoneError').style.display = 'block';
                                hasErr = true;
                            } else {
                                document.getElementById('phoneError').style.display = 'none';
                            }

                            if (hasErr) return;
                        }
                        goToStep(Math.min(4, currentStep + 1));
                    }

                    // Prev
                    if (e.target.closest('.prev-step')) {
                        goToStep(Math.max(1, currentStep - 1));
                    }

                    // Pet Selection
                    const petCard = e.target.closest('.pet-type-card');
                    if (petCard) {
                        document.querySelectorAll('.pet-type-card').forEach(c => c.classList.remove('selected', 'border-primary', 'bg-light'));
                        petCard.classList.add('selected', 'border-primary', 'bg-light');
                        document.getElementById('hiddenPetType').value = petCard.dataset.pet;
                    }

                    // Slot Selection
                    const slotBtn = e.target.closest('.slot-btn');
                    if (slotBtn) {
                        document.querySelectorAll('.slot-btn').forEach(b => {
                            b.classList.remove('selected', 'btn-primary', 'text-white');
                            b.classList.add('btn-outline-secondary');
                        });
                        slotBtn.classList.add('selected', 'btn-primary', 'text-white');
                        slotBtn.classList.remove('btn-outline-secondary');
                        document.getElementById('hiddenTimeSlot').value = slotBtn.textContent.trim();
                    }
                });

                document.getElementById('datePicker')?.addEventListener('change', (e) => {
                    document.getElementById('hiddenAppointmentDate').value = e.target.value;
                });

                // زر التأكيد النهائي يرسل الفورم برمجياً بدون قيود validation مخفية
                document.getElementById('submitBookingBtn')?.addEventListener('click', () => {
                    syncSummary();
                    document.getElementById('bookingForm').submit();
                });
    </script>
}