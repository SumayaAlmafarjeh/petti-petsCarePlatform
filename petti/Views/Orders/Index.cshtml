@model IEnumerable<petti.Models.Order>
@{
    ViewData["Title"] = "My Orders Petti";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header class="page-header">
    <div class="container-petti">
        <div class="breadcrumb-petti">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <i class="fa-solid fa-chevron-right" style="font-size:0.65rem;"></i>
            <span>My Orders</span>
        </div>
        <h1>My Orders</h1>
    </div>
</header>

<section class="section-tight">
    <div class="container-petti" style="max-width:820px;">

        <div class="portal-tabs">
            <button type="button" class="active" data-status-tab="active">Active Orders</button>
            <button type="button" data-status-tab="past">Past Orders</button>
        </div>

        <div id="ordersList" class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                var isDelivered = order.Status.Equals("Delivered", StringComparison.OrdinalIgnoreCase) ||
                                  order.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase);
                var itemsJson = System.Text.Json.JsonSerializer.Serialize(order.OrderItems.Select(i => new
                {
                    name = i.Product?.Name ?? "Product",
                    qty = i.Quantity,
                    price = i.UnitPrice,
                    img = i.Product?.Images.Select(img => img.ImageUrl).FirstOrDefault() ?? "/images/placeholder-product.png"
                }));

                <div class="card border-0 shadow-sm rounded-4 p-4 order-card"
                     data-status="@(isDelivered ? "past" : "active")"
                     style="background:#fff;">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pb-3 border-bottom">
                        <div>
                            <span class="fw-bold fs-6">Order #PT-@order.OrderId</span>
                            <div class="small text-muted">Placed on @order.OrderDate.ToString("MMM dd, yyyy")</div>
                        </div>
                        <div>
                            @if (isDelivered)
                            {
                                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                    <i class="fa-solid fa-circle-check me-1"></i> Delivered
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle px-3 py-2">
                                    <i class="fa-solid fa-clock me-1"></i> @order.Status
                                </span>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3">
                        <span class="fw-bold fs-6 text-berry">@order.TotalAmount.ToString("0.00") JOD</span>
                        <button type="button" class="btn-petti btn-ink-outline btn-sm view-details-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#orderDetailsModal"
                                data-id="@order.OrderId"
                                data-address="@order.Area, @order.StreetAddress"
                                data-total="@order.TotalAmount.ToString("0.00") JOD"
                                data-items='@itemsJson'>
                            View Details <i class="fa-solid fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>
            }
        </div>

        <div class="empty-state" id="ordersEmpty" style="display:none; text-align:center; padding:4rem 1rem;">
            <i class="fa-solid fa-box-open" style="font-size:2.5rem; color:#9AA2B3; margin-bottom:1rem;"></i>
            <h3>Nothing here yet</h3>
            <p style="margin:0; color:#667085;">Orders in this tab will show up once they're placed.</p>
        </div>

    </div>
</section>

<!-- Order details modal -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content petti-modal">
            <div class="modal-header">
                <div class="modal-service-name" id="detailsOrderId">Order</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label class="form-label-petti">Delivery address</label>
                <p id="detailsAddress" style="font-size:0.9rem;color:var(--ink-soft);margin-bottom:1rem;"></p>
                <label class="form-label-petti">Items</label>
                <div id="detailsItems" style="margin-bottom:1rem;"></div>
                <div class="booking-summary-row" style="font-size:1rem;">
                    <span>Total paid</span>
                    <span id="detailsTotal" class="text-berry fw-bold">—</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let activeTab = 'active';

        function filterOrders() {
            const cards = document.querySelectorAll('.order-card');
            let visibleCount = 0;

            cards.forEach(card => {
                if (card.dataset.status === activeTab) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

            document.getElementById('ordersEmpty').style.display = visibleCount === 0 ? 'block' : 'none';
        }

        document.querySelectorAll('[data-status-tab]').forEach(tabBtn => {
            tabBtn.addEventListener('click', () => {
                document.querySelectorAll('[data-status-tab]').forEach(b => b.classList.remove('active'));
                tabBtn.classList.add('active');
                activeTab = tabBtn.dataset.statusTab;
                filterOrders();
            });
        });

        document.addEventListener('click', (e) => {
            const btn = e.target.closest('.view-details-btn');
            if (!btn) return;

            document.getElementById('detailsOrderId').textContent = `Order #PT-${btn.dataset.id}`;
            document.getElementById('detailsAddress').textContent = btn.dataset.address;
            document.getElementById('detailsTotal').textContent = btn.dataset.total;

            const items = JSON.parse(btn.dataset.items || '[]');
            document.getElementById('detailsItems').innerHTML = items.map(it => `
                    <div class="d-flex align-items-center justify-content-between gap-2 py-1 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <img src="${it.img}" alt="${it.name}" style="width:36px;height:36px;border-radius:8px;object-fit:cover;">
                            <span style="font-size:0.88rem;color:var(--ink-soft);">${it.name} × ${it.qty}</span>
                        </div>
                        <span class="fw-semibold small">${(it.price * it.qty).toFixed(2)} JOD</span>
                    </div>
                `).join('');
        });

        filterOrders();
    </script>
}