<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Petti</title>
    <meta name="description" content="Shop pet essentials and book certified at-home grooming, bathing and sitting visits — all in one place.">

    <!-- Bootstrap 5.3.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6.5.0 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- Petti Design System -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>

    <!-- =========================================================
         NAVBAR — floating glassmorphism
         ========================================================= -->
    <nav class="petti-nav">
        <div class="petti-nav-inner" id="navInner">

            <a asp-controller="Home" asp-action="Index" class="petti-logo">
                <span class="paw-badge"><i class="fa-solid fa-paw"></i></span>
                Petti
            </a>

            <div class="nav-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Search food, toys, grooming...">
            </div>

            <div class="nav-links">
                <a href="#services">Home Care</a>
                <a href="#products">Shop</a>
                <a href="#why-petti">Why Petti</a>
                <a href="#testimonials">Reviews</a>
            </div>

            <div class="nav-actions">
                <partial name="_LoginPartial" />
                <button class="btn-icon-circle cart-trigger" aria-label="Open cart" data-bs-toggle="tooltip" title="Your cart">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <span class="cart-badge" id="cartBadge">0</span>
                </button>
            </div>

        </div>
    </nav>

    <!-- المحتوى المتغير للصفحات -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- =========================================================
         FOOTER
         ========================================================= -->
    <footer class="petti-footer">
        <div class="container-petti">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="footer-logo"><i class="fa-solid fa-paw"></i> Petti</div>
                    <p style="color:#9AA2B3; font-size:0.9rem; max-width:320px;">Doorstep pet essentials and certified at-home care, in one platform built around your pet's comfort.</p>
                    <div class="safety-strip" style="margin-top:1.2rem;"><i class="fa-solid fa-shield-check"></i> Every caregiver is ID-verified and background-checked</div>
                    <div class="social-row">
                        <a href="#" class="social-circle" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="social-circle" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" class="social-circle" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <h4>Shop</h4>
                    <ul class="footer-links">
                        <li><a href="#products">Food</a></li>
                        <li><a href="#products">Toys</a></li>
                        <li><a href="#products">Health</a></li>
                        <li><a href="#products">Bathing supplies</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h4>Home Care</h4>
                    <ul class="footer-links">
                        <li><a href="#services">Grooming</a></li>
                        <li><a href="#services">Bathing</a></li>
                        <li><a href="#services">Sitting</a></li>
                        <li><a href="#">Become a caregiver</a></li>
                    </ul>
                </div>

                <div class="col-lg-4">
                    <h4>Coverage areas in Amman</h4>
                    <div style="margin-bottom:0.8rem;">
                        <span class="coverage-pill"><i class="fa-solid fa-location-dot"></i> Abdoun</span>
                        <span class="coverage-pill"><i class="fa-solid fa-location-dot"></i> Sweifieh</span>
                        <span class="coverage-pill"><i class="fa-solid fa-location-dot"></i> Dabouq</span>
                        <span class="coverage-pill"><i class="fa-solid fa-location-dot"></i> Jubeiha</span>
                        <span class="coverage-pill"><i class="fa-solid fa-location-dot"></i> Khalda</span>
                    </div>
                    <h4 style="margin-top:1.4rem;">Get 10% off your first visit</h4>
                    <form class="newsletter-form" id="newsletterForm">
                        <input type="email" required placeholder="you@email.com" aria-label="Email address">
                        <button type="submit" class="btn-petti btn-berry btn-sm" aria-label="Subscribe"><i class="fa-solid fa-paper-plane"></i></button>
                    </form>
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; 2026 Petti. All rights reserved.</span>
                <span>Amman, Jordan</span>
            </div>
        </div>
    </footer>

    <!-- =========================================================
         TOAST — Add to Cart
         ========================================================= -->
    <div class="cart-toast" id="cartToast" role="status" aria-live="polite">
        <span class="cart-toast-icon"><i class="fa-solid fa-check"></i></span>
        <img id="toastImg" src="" alt="">
        <div class="cart-toast-body">
            <div class="cart-toast-title" id="toastTitle">Item added</div>
            <div class="cart-toast-sub">Added to your cart</div>
        </div>
        <div class="cart-toast-price" id="toastPrice"></div>
        <button id="toastClose" aria-label="Dismiss" style="background:none;border:none;color:var(--ink-faint);font-size:0.9rem;">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>