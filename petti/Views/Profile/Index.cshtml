@model petti.Areas.Customer.Controllers.ProfileController.ProfileViewModel
@{
    ViewData["Title"] = "My Profile Petti";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<header class="page-header">
    <div class="container-petti">
        <div class="breadcrumb-petti">
            <a asp-controller="Home" asp-action="Index" asp-area="">Home</a>
            <i class="fa-solid fa-chevron-right" style="font-size:0.65rem;"></i>
            <span>My Profile</span>
        </div>
        <h1>My Profile &amp; Preferences</h1>
    </div>
</header>

<section class="section-tight">
    <div class="container-petti" style="max-width:820px;">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- 1. Personal & Contact Card -->
        <div class="profile-card mb-4">
            <div class="d-flex align-items-center gap-3" style="margin-bottom:1.6rem;">
                <span class="profile-avatar">@Model.Initials</span>
                <div>
                    <h3 style="margin-bottom:0.2rem;">@Model.FullName</h3>
                    <p style="margin:0;font-size:0.85rem;color:var(--ink-soft);">Member since @Model.MemberSince</p>
                </div>
            </div>

            <form asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-petti" asp-for="FullName">Full name</label>
                        <input asp-for="FullName" class="form-control-petti" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti" asp-for="PhoneNumber">Mobile number</label>
                        <input asp-for="PhoneNumber" class="form-control-petti" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti" asp-for="City">Amman area</label>
                        <input asp-for="City" class="form-control-petti" placeholder="e.g. Abdoun" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti" asp-for="Address">Street &amp; building</label>
                        <input asp-for="Address" class="form-control-petti" placeholder="e.g. Rainbow St, Bldg 14, Apt 3" />
                    </div>
                </div>
                <button type="submit" class="btn-petti btn-berry" style="margin-top:1.4rem;">
                    Save Changes <i class="fa-solid fa-check ms-1"></i>
                </button>
            </form>
        </div>

        <!-- Saved Pet Profile Card -->
        <div class="profile-card mb-4">
            <h3 style="margin-bottom:1.2rem;">Saved Pet Profile</h3>

            <!-- 1. Display View (Card) -->
            <div class="pet-profile-card" id="petDisplayCard" style="margin-bottom:1rem;">
                <span class="pet-profile-icon">
                    <i class="fa-solid @(Model.PetType?.ToLower() == "cat" ? "fa-cat" : "fa-dog")" id="petIconPreview"></i>
                </span>
                <div style="flex:1;">
                    <strong id="petNameLabel">@Model.PetName</strong>
                    <div style="font-size:0.82rem;color:var(--ink-faint);" id="petTypeLabel">@Model.PetType</div>
                </div>
                <button type="button" class="table-icon-btn" id="btnEditPet" title="Edit Pet">
                    <i class="fa-solid fa-pen"></i>
                </button>
            </div>

            <!-- 2. Expandable Form (Hidden by default) -->
            <div id="petEditSection" style="display:none; background:#F8FAFC; border-radius:1rem; padding:1.25rem; margin-bottom:1rem; border:1px solid #E2E8F0;">
                <h5 class="h6 fw-bold mb-3" id="petFormTitle">Edit Pet Details</h5>
                <form asp-action="UpdatePetProfile" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label-petti" asp-for="PetName">Pet Name</label>
                            <input asp-for="PetName" class="form-control-petti" placeholder="e.g. Max, Luna, Bella" required />
                            <span asp-validation-for="PetName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label-petti" asp-for="PetType">Pet Type</label>
                            <select asp-for="PetType" class="form-select form-control-petti">
                                <option value="Dog">Dog</option>
                                <option value="Cat">Cat</option>
                                <option value="Bird">Bird</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn-petti btn-berry btn-sm">
                            Save Pet <i class="fa-solid fa-check ms-1"></i>
                        </button>
                        <button type="button" class="btn-petti btn-ink-outline btn-sm" id="btnCancelPet">
                            Cancel
                        </button>
                    </div>
                </form>
            </div>

        </div>

        <!-- 3. Password & Security Card -->
        <div class="profile-card">
            <h3 style="margin-bottom:1.2rem;">Password &amp; Security</h3>
            <form asp-action="UpdatePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-petti" asp-for="CurrentPassword">Current password</label>
                        <input asp-for="CurrentPassword" class="form-control-petti" placeholder="••••••••" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6"></div>
                    <div class="col-md-6">
                        <label class="form-label-petti" asp-for="NewPassword">New password</label>
                        <input asp-for="NewPassword" class="form-control-petti" placeholder="••••••••" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-petti" asp-for="ConfirmPassword">Confirm new password</label>
                        <input asp-for="ConfirmPassword" class="form-control-petti" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
                <button type="submit" class="btn-petti btn-ink-outline" style="margin-top:1.4rem;">
                    Update Password <i class="fa-solid fa-shield-halved ms-1"></i>
                </button>
            </form>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const btnEditPet = document.getElementById('btnEditPet');
        const btnAddPet = document.getElementById('btnAddPet');
        const btnCancelPet = document.getElementById('btnCancelPet');
        const petEditSection = document.getElementById('petEditSection');
        const petDisplayCard = document.getElementById('petDisplayCard');
        const petFormTitle = document.getElementById('petFormTitle');

        function openPetForm(title) {
            petFormTitle.innerText = title;
            petEditSection.style.display = 'block';
            btnAddPet.style.display = 'none';
        }

        function closePetForm() {
            petEditSection.style.display = 'none';
            btnAddPet.style.display = 'inline-flex';
        }

        if (btnEditPet) {
            btnEditPet.addEventListener('click', () => openPetForm('Edit Pet Details'));
        }

        if (btnAddPet) {
            btnAddPet.addEventListener('click', () => openPetForm('Add / Update Pet'));
        }

        if (btnCancelPet) {
            btnCancelPet.addEventListener('click', closePetForm);
        }
    </script>
}