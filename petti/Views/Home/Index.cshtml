@{
    ViewData["Title"] = "Doorstep Pet Care & Premium Essentials";
}

<!-- =========================================================
     HERO
     ========================================================= -->
<header class="hero">
    <div class="container-petti">
        <div class="hero-grid">

            <div class="hero-copy reveal-on-load">
                <span class="eyebrow-tag"><i class="fa-solid fa-house-chimney"></i> Now serving Amman</span>
                <h1 style="margin-top:1rem;">Doorstep Pet Care <span class="accent-word">&amp; Premium Essentials</span></h1>
                <p class="lead">Order food and supplies, then book a certified groomer, bather or sitter to your door — one platform, fixed prices, no stressful car rides for your pet.</p>

                <div class="hero-cta-row">
                    <a href="#products" class="btn-petti btn-berry"><i class="fa-solid fa-bag-shopping"></i> Shop Supplies</a>
                    <a href="#services" class="btn-petti btn-royal-outline"><i class="fa-solid fa-calendar-check"></i> Book Home Care</a>
                </div>

                <div class="hero-stats">
                    <span class="stat-chip"><span class="icon-dot berry"><i class="fa-solid fa-shield-heart"></i></span> 100% Certified Care</span>
                    <span class="stat-chip"><span class="icon-dot royal"><i class="fa-solid fa-location-dot"></i></span> Doorstep Visits in Amman</span>
                    <span class="stat-chip"><span class="icon-dot sunbeam"><i class="fa-solid fa-star"></i></span> 4.9 average rating</span>
                </div>
            </div>

            <div class="hero-visual reveal-on-load">
                <div class="hero-visual-card">
                    <img src="~/images/heroCat.jfif" alt="Groomer gently brushing a pet at home">
                </div>

                <div class="floating-badge badge-top">
                    <span class="fb-icon" style="background:var(--berry);"><i class="fa-solid fa-clock"></i></span>
                    <div>
                        <div class="fb-title">45 min visit</div>
                        <div class="fb-sub">Fixed time slots</div>
                    </div>
                </div>

                <div class="floating-badge badge-bottom">
                    <span class="fb-icon" style="background:var(--royal);"><i class="fa-solid fa-badge-check"></i></span>
                    <div>
                        <div class="fb-title">Vetted caregivers</div>
                        <div class="fb-sub">Background-checked</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</header>

<!-- =========================================================
     CATEGORY / FILTER PILLS
     ========================================================= -->
<section class="section-tight">
    <div class="container-petti">
        <div class="filter-pill-row" data-filter-group="#products-grid">
            <button class="filter-pill active" data-filter="all"><i class="fa-solid fa-grip"></i> All</button>
            <button class="filter-pill" data-filter="food"><i class="fa-solid fa-bone"></i> Food</button>
            <button class="filter-pill" data-filter="toys"><i class="fa-solid fa-baseball"></i> Toys</button>
            <button class="filter-pill" data-filter="grooming"><i class="fa-solid fa-scissors"></i> Home Grooming</button>
            <button class="filter-pill" data-filter="bathing"><i class="fa-solid fa-shower"></i> Bathing</button>
            <button class="filter-pill" data-filter="health"><i class="fa-solid fa-kit-medical"></i> Health</button>
        </div>
    </div>
</section>

<!-- =========================================================
     DOORSTEP SERVICES SHOWCASE
     ========================================================= -->
<section class="section" id="services">
    <div class="container-petti">

        <div class="section-heading">
            <span class="eyebrow-tag"><i class="fa-solid fa-house-chimney-user"></i> At-home visits</span>
            <h2 style="margin-top:0.9rem;">Certified care, right at your door</h2>
            <p>Every visit is fixed-price, fixed-duration, and carried out by a background-checked caregiver.</p>
        </div>

        <div class="row g-4" style="margin-top:1.5rem;">

            <div class="col-md-4">
                <div class="service-card" data-service-name="Home Grooming" data-service-price="18 JOD">
                    <span class="service-card-icon" style="background:var(--berry);"><i class="fa-solid fa-scissors"></i></span>
                    <h3>Home Grooming</h3>
                    <p class="service-desc">Full coat trim, styling and de-shedding treatment, tailored to your pet's breed.</p>
                    <div class="service-meta-row">
                        <span class="duration-tag"><i class="fa-solid fa-clock"></i> 60 min</span>
                        <span class="price-tag">From 18 JOD</span>
                    </div>
                    <ul class="service-checklist">
                        <li><i class="fa-solid fa-circle-check"></i> Breed-specific trim & styling</li>
                        <li><i class="fa-solid fa-circle-check"></i> Ear cleaning & nail trim included</li>
                        <li><i class="fa-solid fa-circle-check"></i> De-shedding brush-out</li>
                    </ul>
                    <button class="btn-petti book-visit-btn">Book Visit <i class="fa-solid fa-arrow-right"></i></button>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card" data-service-name="Bathing" data-service-price="12 JOD">
                    <span class="service-card-icon" style="background:var(--royal);"><i class="fa-solid fa-shower"></i></span>
                    <h3>Bathing</h3>
                    <p class="service-desc">Gentle wash with hypoallergenic shampoo, blow-dry, and paw balm finish.</p>
                    <div class="service-meta-row">
                        <span class="duration-tag"><i class="fa-solid fa-clock"></i> 30 min</span>
                        <span class="price-tag">From 12 JOD</span>
                    </div>
                    <ul class="service-checklist">
                        <li><i class="fa-solid fa-circle-check"></i> Hypoallergenic shampoo</li>
                        <li><i class="fa-solid fa-circle-check"></i> Warm-air blow dry</li>
                        <li><i class="fa-solid fa-circle-check"></i> Paw pad conditioning balm</li>
                    </ul>
                    <button class="btn-petti book-visit-btn">Book Visit <i class="fa-solid fa-arrow-right"></i></button>
                </div>
            </div>

            <div class="col-md-4">
                <div class="service-card" data-service-name="Pet Sitting" data-service-price="9 JOD/hr">
                    <span class="service-card-icon" style="background:#7C3AED;"><i class="fa-solid fa-house-chimney-heart"></i></span>
                    <h3>Pet Sitting</h3>
                    <p class="service-desc">A vetted sitter keeps your pet company, fed, and walked while you're away.</p>
                    <div class="service-meta-row">
                        <span class="duration-tag"><i class="fa-solid fa-clock"></i> Per hour</span>
                        <span class="price-tag">From 9 JOD/hr</span>
                    </div>
                    <ul class="service-checklist">
                        <li><i class="fa-solid fa-circle-check"></i> Feeding & fresh water refills</li>
                        <li><i class="fa-solid fa-circle-check"></i> Walks & play breaks</li>
                        <li><i class="fa-solid fa-circle-check"></i> Photo updates during the visit</li>
                    </ul>
                    <button class="btn-petti book-visit-btn">Book Visit <i class="fa-solid fa-arrow-right"></i></button>
                </div>
            </div>

        </div>
    </div>
</section>

