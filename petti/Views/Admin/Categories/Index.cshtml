@model IEnumerable<petti.Models.Category>
@{
    ViewData["Title"] = "Categories";
    ViewData["HeaderTitle"] = "Categories";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show rounded-4 mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="admin-panel">
    <!-- Filter & Add Button Header -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex flex-wrap gap-2 flex-grow-1" style="max-width: 550px;">
            <input type="text" id="adminCategorySearch" class="form-control-petti" style="max-width: 280px;" placeholder="Search categories...">
            <select id="adminTypeFilter" class="form-control-petti" style="max-width: 180px;">
                <option value="all">All types</option>
                <option value="product">Product</option>
                <option value="service">Service</option>
            </select>
        </div>

        <button type="button" class="btn-petti btn-berry" onclick="openCreateModal()">
            <i class="fa-solid fa-plus me-1"></i> Add Category
        </button>
    </div>

    <!-- Categories Table -->
    <div style="overflow-x:auto;">
        <table class="table-petti w-100 align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 60px;">Icon</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Linked Items</th>
                    <th style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody id="categoriesBody">
                @foreach (var c in Model)
                {
                    var isProduct = c.Type.Equals("Product", StringComparison.OrdinalIgnoreCase);
                    var count = isProduct ? c.Products.Count : c.Services.Count;

                    <tr class="admin-category-row" data-name="@c.Name.ToLower()" data-type="@c.Type.ToLower()">
                        <td>
                            <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-light text-berry"
                                  style="width: 40px; height: 40px; font-size: 1.15rem;">
                                <i class="fa-solid @(string.IsNullOrEmpty(c.IconClass) ? "fa-paw" : c.IconClass)"></i>
                            </span>
                        </td>
                        <td>
                            <strong>@c.Name</strong>
                            @if (!string.IsNullOrEmpty(c.Description))
                            {
                                <div style="font-size: 0.75rem; color: var(--ink-faint);">@c.Description</div>
                            }
                        </td>
                        <td>
                            @if (isProduct)
                            {
                                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 fw-semibold">
                                    Product
                                </span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-info-subtle text-info border border-info-subtle px-3 py-1 fw-semibold" style="color: #6366F1 !important; background-color: #EEF2FF !important; border-color: #E0E7FF !important;">
                                    Service
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                @count @(isProduct ? "products" : "services")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <!-- Edit Button -->
                                <button type="button" class="table-icon-btn border-0 bg-transparent text-decoration-none"
                                        onclick="openEditModal(@c.CategoryId, '@c.Name', '@c.Type', '@c.Description')"
                                        title="Edit Category">
                                    <i class="fa-solid fa-pen"></i>
                                </button>

                                <!-- Delete Button -->
                                <button type="button"
                                        class="table-icon-btn text-danger border-0 bg-transparent delete-trigger-btn"
                                        data-id="@c.CategoryId"
                                        data-name="@c.Name"
                                        title="Delete Category">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top mt-3" id="paginationWrapper">
        <div class="text-muted small" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
        <div class="d-flex align-items-center gap-1" id="paginationControls"></div>
    </div>
</div>

<!-- Modal: Category Create & Edit -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content petti-modal border-0 rounded-4 shadow">
            <div class="modal-header border-bottom">
                <div class="modal-service-name" id="modalTitle">Add Category</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CategorySave" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <input type="hidden" name="CategoryId" id="catIdInput" value="0" />

                    <div class="mb-3">
                        <label class="form-label-petti">Category Name</label>
                        <input type="text" name="Name" id="catNameInput" class="form-control-petti" placeholder="e.g. Dental Care" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-petti">Type</label>
                        <select name="Type" id="catTypeInput" class="form-control-petti" required>
                            <option value="Product">Product</option>
                            <option value="Service">Service</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label-petti">Description (optional)</label>
                        <input type="text" name="Description" id="catDescInput" class="form-control-petti" placeholder="Short description" />
                    </div>

                    <button type="submit" class="btn-petti btn-berry w-100 justify-content-center py-2">
                        Save Category <i class="fa-solid fa-check ms-1"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Custom Delete Confirmation -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 rounded-4 shadow p-4 text-center" style="background: #fff;">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                 style="width: 64px; height: 64px; background: #FEE2E2; color: #DC2626; font-size: 1.6rem;">
                <i class="fa-solid fa-trash-can"></i>
            </div>

            <h4 class="fw-bold mb-2">Delete Category</h4>
            <p class="text-muted small mb-4">
                Are you sure you want to delete category <strong id="deleteCategoryName" class="text-dark"></strong>?
            </p>

            <form id="deleteCategoryForm" asp-action="CategoryDelete" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2 justify-content-center">
                    <button type="button" class="btn-petti btn-ink-outline px-4" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn-petti btn-berry px-4" style="background: #DC2626; border-color: #DC2626;">
                        Yes, Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pagination & Filter Configuration
        const pageSize = 10;
        let currentPage = 1;
        let visibleRows = [];

        const searchInput = document.getElementById('adminCategorySearch');
        const typeSelect = document.getElementById('adminTypeFilter');
        const allRows = Array.from(document.querySelectorAll('.admin-category-row'));
        const paginationControls = document.getElementById('paginationControls');
        const paginationInfo = document.getElementById('paginationInfo');
        const paginationWrapper = document.getElementById('paginationWrapper');

        function applyFilterAndPagination() {
            const search = searchInput.value.trim().toLowerCase();
            const type = typeSelect.value;

            visibleRows = allRows.filter(row => {
                const name = row.dataset.name;
                const rowType = row.dataset.type;
                const matchesType = (type === 'all' || rowType === type);
                const matchesSearch = (!search || name.includes(search));
                return matchesType && matchesSearch;
            });

            const totalPages = Math.ceil(visibleRows.length / pageSize) || 1;
            if (currentPage > totalPages) currentPage = 1;

            allRows.forEach(r => r.style.display = 'none');

            const start = (currentPage - 1) * pageSize;
            const end = start + pageSize;
            const pageRows = visibleRows.slice(start, end);
            pageRows.forEach(r => r.style.display = '');

            const startCount = visibleRows.length === 0 ? 0 : start + 1;
            const endCount = Math.min(end, visibleRows.length);
            paginationInfo.textContent = `Showing ${startCount} to ${endCount} of ${visibleRows.length} entries`;

            renderPaginationButtons(totalPages);
        }

        function renderPaginationButtons(totalPages) {
            paginationControls.innerHTML = '';

            if (visibleRows.length <= pageSize) {
                paginationWrapper.style.display = visibleRows.length === 0 ? 'none' : 'flex';
                return;
            } else {
                paginationWrapper.style.display = 'flex';
            }

            const prevBtn = document.createElement('button');
            prevBtn.type = 'button';
            prevBtn.className = `btn btn-sm btn-light border rounded-3 px-2 ${currentPage === 1 ? 'disabled opacity-50' : ''}`;
            prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left" style="font-size:0.75rem;"></i>';
            prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; applyFilterAndPagination(); } };
            paginationControls.appendChild(prevBtn);

            for (let i = 1; i <= totalPages; i++) {
                const pageBtn = document.createElement('button');
                pageBtn.type = 'button';
                const isActive = (i === currentPage);
                pageBtn.className = `btn btn-sm rounded-3 px-3 fw-semibold ${isActive ? 'btn-berry text-white' : 'btn-light border'}`;
                pageBtn.textContent = i;
                pageBtn.onclick = () => { currentPage = i; applyFilterAndPagination(); };
                paginationControls.appendChild(pageBtn);
            }

            const nextBtn = document.createElement('button');
            nextBtn.type = 'button';
            nextBtn.className = `btn btn-sm btn-light border rounded-3 px-2 ${currentPage === totalPages ? 'disabled opacity-50' : ''}`;
            nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right" style="font-size:0.75rem;"></i>';
            nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; applyFilterAndPagination(); } };
            paginationControls.appendChild(nextBtn);
        }

        searchInput.addEventListener('input', () => { currentPage = 1; applyFilterAndPagination(); });
        typeSelect.addEventListener('change', () => { currentPage = 1; applyFilterAndPagination(); });

        applyFilterAndPagination();

        // Category Modal Controls
        const catModalEl = document.getElementById('categoryModal');
        const catModal = new bootstrap.Modal(catModalEl);
        const catIdInput = document.getElementById('catIdInput');
        const catNameInput = document.getElementById('catNameInput');
        const catTypeInput = document.getElementById('catTypeInput');
        const catDescInput = document.getElementById('catDescInput');
        const modalTitle = document.getElementById('modalTitle');

        function openCreateModal() {
            modalTitle.textContent = 'Add Category';
            catIdInput.value = '0';
            catNameInput.value = '';
            catTypeInput.value = 'Product';
            catDescInput.value = '';
            catModal.show();
        }

        function openEditModal(id, name, type, desc) {
            modalTitle.textContent = 'Edit Category';
            catIdInput.value = id;
            catNameInput.value = name;
            catTypeInput.value = type;
            catDescInput.value = desc || '';
            catModal.show();
        }

        // Delete Confirmation Modal Handling
        const deleteModalEl = document.getElementById('deleteConfirmModal');
        const deleteModal = new bootstrap.Modal(deleteModalEl);
        const deleteForm = document.getElementById('deleteCategoryForm');
        const deleteCategoryName = document.getElementById('deleteCategoryName');

        document.querySelectorAll('.delete-trigger-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const id = btn.dataset.id;
                const name = btn.dataset.name;

                deleteCategoryName.textContent = `"${name}"`;
                deleteForm.action = `/Admin/CategoryDelete/${id}`;
                deleteModal.show();
            });
        });
    </script>
}