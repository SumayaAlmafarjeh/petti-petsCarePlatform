@model petti.Models.Product
@{
    ViewData["Title"] = $"{Model.Name} — Petti";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var imagesList = Model.Images != null && Model.Images.Any()
        ? Model.Images.Select(i => i.ImageUrl).ToList()
        : new List<string> { "/images/placeholder-product.png" };

    var reviews = Model.Reviews != null ? Model.Reviews.OrderByDescending(r => r.CreatedAt).ToList() : new List<petti.Models.Review>();
    var reviewsCount = reviews.Count;
    var avgRating = reviewsCount > 0 ? reviews.Average(r => r.Rating) : 0.0;

    int r5 = reviews.Count(r => r.Rating == 5);
    int r4 = reviews.Count(r => r.Rating == 4);
    int r3 = reviews.Count(r => r.Rating == 3);
    int r2 = reviews.Count(r => r.Rating == 2);
    int r1 = reviews.Count(r => r.Rating == 1);

    int pct5 = reviewsCount > 0 ? (int)Math.Round((double)r5 / reviewsCount * 100) : 0;
    int pct4 = reviewsCount > 0 ? (int)Math.Round((double)r4 / reviewsCount * 100) : 0;
    int pct3 = reviewsCount > 0 ? (int)Math.Round((double)r3 / reviewsCount * 100) : 0;
    int pct2 = reviewsCount > 0 ? (int)Math.Round((double)r2 / reviewsCount * 100) : 0;
    int pct1 = reviewsCount > 0 ? (int)Math.Round((double)r1 / reviewsCount * 100) : 0;

    bool canReview = ViewBag.CanReview == true;
}

<section class="section" style="padding-top:8.5rem; padding-bottom:5rem;">
    <div class="container-petti">
        <!-- Breadcrumbs -->
        <div class="breadcrumb-petti mb-4">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <i class="fa-solid fa-chevron-right" style="font-size:0.65rem;"></i>
            <a asp-controller="Products" asp-action="Index">Shop</a>
            <i class="fa-solid fa-chevron-right" style="font-size:0.65rem;"></i>
            <span>@Model.Name</span>
        </div>

        <!-- Product Top View -->
        <div class="row g-5">
            <!-- Left: Gallery & Slider -->
            <div class="col-lg-6">
                <div class="position-relative rounded-4 overflow-hidden border shadow-sm bg-white mb-3" style="aspect-ratio: 1/1;">
                    <img id="mainGalleryImg" src="@imagesList[0]" alt="@Model.Name"
                         style="width: 100%; height: 100%; object-fit: contain; transition: transform 0.3s ease;">

                    @if (imagesList.Count > 1)
                    {
                        <!-- Prev Arrow -->
                        <button type="button" class="btn btn-light rounded-circle shadow-sm position-absolute top-50 start-0 translate-middle-y ms-3 d-flex align-items-center justify-content-center"
                                style="width: 42px; height: 42px; z-index: 5;" onclick="prevSlideImage()">
                            <i class="fa-solid fa-chevron-left"></i>
                        </button>
                        <!-- Next Arrow -->
                        <button type="button" class="btn btn-light rounded-circle shadow-sm position-absolute top-50 end-0 translate-middle-y me-3 d-flex align-items-center justify-content-center"
                                style="width: 42px; height: 42px; z-index: 5;" onclick="nextSlideImage()">
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                    }
                </div>

                @if (imagesList.Count > 1)
                {
                    <div class="d-flex gap-2 flex-wrap" id="galleryThumbsRow">
                        @for (int i = 0; i < imagesList.Count; i++)
                        {
                            <div class="gallery-thumb-item rounded-3 border overflow-hidden @(i == 0 ? "border-primary border-2" : "")"
                                 style="width: 72px; height: 72px; cursor: pointer;" onclick="selectSlideImage(@i)">
                                <img src="@imagesList[i]" alt="Thumbnail" style="width: 100%; height: 100%; object-fit: cover;">
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Right: Product Info -->
            <div class="col-lg-6">
                <div class="badge rounded-pill bg-light text-dark border px-3 py-1 mb-2 fw-semibold">
                    @(Model.Category?.Name ?? "Essentials") · @(Model.TargetPetType ?? "All Pets")
                </div>
                <h1 class="fw-bold mb-2" style="font-size: 2.1rem; color: var(--ink);">@Model.Name</h1>

                <!-- Rating Section (Top) -->
                <div class="d-flex align-items-center gap-2 mb-3">
                    @if (reviewsCount > 0)
                    {
                        <span style="color: #F59E0B;" class="small">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa-solid fa-star @(i <= Math.Round(avgRating) ? "" : "text-muted opacity-25")"></i>
                            }
                        </span>
                        <strong style="color: var(--ink);">@avgRating.ToString("0.0")</strong>
                        <span class="text-muted small">(@reviewsCount @(reviewsCount == 1 ? "review" : "reviews"))</span>
                    }
                    else
                    {
                        <span class="small text-muted">
                            <i class="fa-regular fa-star me-1"></i> No reviews yet
                        </span>
                    }
                </div>

                <!-- Stock Bar -->
                <div class="mb-3">
                    <div class="progress rounded-pill" style="height: 6px; max-width: 320px; background-color: #E2E8F0;">
                        <div class="progress-bar rounded-pill" role="progressbar"
                             style="width: @(Model.StockQuantity > 0 ? "75%" : "0%"); background-color: @(Model.StockQuantity > 0 ? "var(--berry)" : "#EF4444");"></div>
                    </div>
                    <span class="small text-muted mt-1 d-block">
                        @(Model.StockQuantity > 0 ? $"{Model.StockQuantity} in stock" : "Out of stock")
                    </span>
                </div>

                <!-- Price -->
                <div class="my-4">
                    <span class="fw-bold fs-2" style="color: var(--berry);">@Model.Price.ToString("0.00") JOD</span>
                </div>

                <!-- Quantity & Add to Cart -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="d-flex align-items-center border rounded-pill bg-white px-2 py-1 shadow-sm" style="width: 120px;">
                        <button type="button" class="btn btn-sm border-0 p-0 text-muted px-2" onclick="changeQty(-1)">−</button>
                        <input type="text" id="pQty" class="form-control text-center border-0 p-0 fw-bold bg-transparent" value="1" readonly style="width: 45px;" />
                        <button type="button" class="btn btn-sm border-0 p-0 text-muted px-2" onclick="changeQty(1)">+</button>
                    </div>

                    <button type="button" class="btn-petti btn-berry add-cart-btn-details flex-grow-1 justify-content-center py-2 fs-6"
                            data-id="@Model.ProductId" data-name="@Model.Name" data-price="@Model.Price" data-img="@imagesList[0]">
                        <i class="fa-solid fa-bag-shopping me-2"></i> Add to Cart
                    </button>
                </div>

                <div class="d-flex flex-column gap-2 pt-3 border-top text-muted small">
                    <div><i class="fa-solid fa-truck-fast me-2 text-primary"></i> Doorstep delivery across Amman</div>
                    <div><i class="fa-solid fa-shield-heart me-2 text-danger"></i> 100% genuine ingredients & safety inspected</div>
                </div>
            </div>
        </div>

        <!-- Product Tabs -->
        <div style="margin-top: 4.5rem;">
            <div class="d-flex gap-2 border-bottom mb-4" id="pdTabsNav">
                <button type="button" class="btn btn-link text-decoration-none fw-bold pb-2 border-0 active tab-btn text-berry border-bottom border-3 border-danger" data-target="tab-desc">
                    Description & Specs
                </button>
                <button type="button" class="btn btn-link text-decoration-none fw-bold pb-2 border-0 text-muted tab-btn" data-target="tab-reviews">
                    Reviews (@reviewsCount)
                </button>
            </div>

            <!-- Tab 1: Description -->
            <div id="tab-desc" class="tab-pane-content">
                <p class="text-muted" style="max-width: 680px; line-height: 1.7;">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Quality essentials sourced specifically for your pet's daily comfort and dietary requirements." : Model.Description)
                </p>
                <ul class="text-muted small ps-3" style="max-width: 680px; line-height: 1.8;">
                    <li>Tailored for @(Model.TargetPetType ?? "all types of pets")</li>
                    <li>Packaged securely to maintain freshness until delivery</li>
                    <li>Caregiver recommended for daily grooming and wellness routines</li>
                </ul>
            </div>

            <!-- Tab 2: Reviews -->
            <div id="tab-reviews" class="tab-pane-content" style="display:none;">
                <div class="row g-5">
                    <!-- Left Breakdown -->
                    <div class="col-md-4">
                        @if (reviewsCount > 0)
                        {
                            <div class="fs-1 fw-bold text-dark" id="avgScoreDisplay">@avgRating.ToString("0.0")</div>
                            <div style="color: #F59E0B;" class="mb-2" id="avgStarsRow">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa-solid fa-star @(i <= Math.Round(avgRating) ? "" : "text-muted opacity-25")"></i>
                                }
                            </div>
                            <div class="text-muted small mb-4" id="avgCountDisplay">Based on @reviewsCount @(reviewsCount == 1 ? "review" : "reviews")</div>

                            <!-- Rating Bars -->
                            <div class="d-flex align-items-center gap-2 mb-2 small text-muted">
                                <span style="width:12px;">5</span>
                                <div class="progress flex-grow-1" style="height:6px;"><div class="progress-bar bg-warning" style="width: @pct5%;"></div></div>
                                <span style="width:30px; text-align:right;">@pct5%</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2 small text-muted">
                                <span style="width:12px;">4</span>
                                <div class="progress flex-grow-1" style="height:6px;"><div class="progress-bar bg-warning" style="width: @pct4%;"></div></div>
                                <span style="width:30px; text-align:right;">@pct4%</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2 small text-muted">
                                <span style="width:12px;">3</span>
                                <div class="progress flex-grow-1" style="height:6px;"><div class="progress-bar bg-warning" style="width: @pct3%;"></div></div>
                                <span style="width:30px; text-align:right;">@pct3%</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2 small text-muted">
                                <span style="width:12px;">2</span>
                                <div class="progress flex-grow-1" style="height:6px;"><div class="progress-bar bg-warning" style="width: @pct2%;"></div></div>
                                <span style="width:30px; text-align:right;">@pct2%</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-4 small text-muted">
                                <span style="width:12px;">1</span>
                                <div class="progress flex-grow-1" style="height:6px;"><div class="progress-bar bg-warning" style="width: @pct1%;"></div></div>
                                <span style="width:30px; text-align:right;">@pct1%</span>
                            </div>
                        }
                        else
                        {
                            <div class="mb-4">
                                <div class="fs-4 fw-bold text-dark mb-1">No reviews yet</div>
                                <div class="text-muted small">Be the first to share your thoughts on this product.</div>
                            </div>
                        }

                        <!-- Write Review Button (Visible only to verified buyers) -->
                        @if (canReview)
                        {
                            <button type="button" class="btn-petti btn-berry btn-sm" data-bs-toggle="modal" data-bs-target="#productReviewModal">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Write a Review
                            </button>
                        }
                        else
                        {
                            <div class="p-3 bg-light rounded-3 text-muted small border">
                                <i class="fa-solid fa-shield-check text-success me-1"></i> Reviews are open to pet parents who have purchased this product.
                            </div>
                        }
                    </div>

                    <!-- Right Reviews List -->
                    <div class="col-md-8" id="reviewsListContainer">
                        @if (reviewsCount == 0)
                        {
                            <div class="text-center py-5 border rounded-4 bg-white" id="noReviewsPrompt">
                                <i class="fa-regular fa-comment-dots text-muted mb-2 fs-1"></i>
                                <h6 class="fw-bold">No customer reviews</h6>
                                <p class="text-muted small mb-0">Verified pet parents who purchased this product can leave their ratings here.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var r in reviews)
                            {
                                var author = r.Customer != null ? (!string.IsNullOrWhiteSpace(r.Customer.FullName) ? r.Customer.FullName : r.Customer.UserName) : "Verified Buyer";
                                var initial = !string.IsNullOrWhiteSpace(author) ? author.Trim()[0].ToString().ToUpper() : "P";

                                <div class="p-3 bg-white rounded-4 border shadow-sm mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                                 style="width: 34px; height: 34px; background: linear-gradient(135deg, var(--berry), #BE123C); font-size: 0.85rem;">
                                                @initial
                                            </div>
                                            <div>
                                                <strong style="color:var(--ink); font-size:0.92rem;">@author</strong>
                                                <span class="badge rounded-pill bg-success-subtle text-success border px-2 py-0 ms-1" style="font-size:0.65rem;">Verified Buyer</span>
                                            </div>
                                        </div>
                                        <div style="color: #F59E0B;" class="small">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fa-solid fa-star @(i <= r.Rating ? "" : "text-muted opacity-25")"></i>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-1" style="line-height: 1.5;">@r.Comment</p>
                                    <span class="text-muted" style="font-size:0.75rem;">@r.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Review Modal (Verified Buyers Only) -->
@if (canReview)
{
    <div class="modal fade" id="productReviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content petti-modal border-0 rounded-4 shadow overflow-hidden">
                <div class="modal-header border-bottom px-4 pt-4 pb-3">
                    <div>
                        <div class="modal-service-name fs-5 fw-bold" style="color:var(--ink);">Rate this product</div>
                        <span class="small text-muted">@Model.Name</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form id="productReviewForm" class="p-4" onsubmit="submitProductReviewAjax(event)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <input type="hidden" name="rating" id="reviewRatingInput" value="5" />

                    <!-- Rating Stars -->
                    <div class="mb-4 text-center">
                        <label class="form-label-petti d-block mb-2">How would you rate it?</label>
                        <div class="d-inline-flex gap-2 star-picker" style="font-size: 1.9rem; cursor: pointer;">
                            <i class="fa-solid fa-star p-star-item" data-val="1" style="color: #F59E0B;"></i>
                            <i class="fa-solid fa-star p-star-item" data-val="2" style="color: #F59E0B;"></i>
                            <i class="fa-solid fa-star p-star-item" data-val="3" style="color: #F59E0B;"></i>
                            <i class="fa-solid fa-star p-star-item" data-val="4" style="color: #F59E0B;"></i>
                            <i class="fa-solid fa-star p-star-item" data-val="5" style="color: #F59E0B;"></i>
                        </div>
                    </div>

                    <!-- Comment Input -->
                    <div class="mb-4">
                        <label class="form-label-petti">Your Review</label>
                        <textarea name="comment" id="reviewCommentInput" class="form-control-petti" rows="3" placeholder="Tell other pet parents what you think of this product..." required style="resize:none;"></textarea>
                    </div>

                    <div id="reviewErrorAlert" class="alert alert-danger p-2 small mb-3 text-center" style="display:none;"></div>

                    <button type="submit" class="btn-petti btn-berry w-100 justify-content-center py-2" id="submitRevBtn">
                        Submit Review <i class="fa-solid fa-paper-plane ms-1"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Image Gallery Slide Logic
        const images = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(imagesList))');
        let activeIdx = 0;

        function updateSliderUI() {
            const mainImg = document.getElementById('mainGalleryImg');
            if (mainImg) {
                mainImg.src = images[activeIdx];
            }
            const thumbs = document.querySelectorAll('.gallery-thumb-item');
            thumbs.forEach((t, i) => {
                if (i === activeIdx) {
                    t.classList.add('border-primary', 'border-2');
                } else {
                    t.classList.remove('border-primary', 'border-2');
                }
            });
        }

        function selectSlideImage(idx) {
            activeIdx = idx;
            updateSliderUI();
        }

        function prevSlideImage() {
            activeIdx = (activeIdx - 1 + images.length) % images.length;
            updateSliderUI();
        }

        function nextSlideImage() {
            activeIdx = (activeIdx + 1) % images.length;
            updateSliderUI();
        }

        // Quantity Stepper
        function changeQty(delta) {
            const el = document.getElementById('pQty');
            let val = parseInt(el.value) + delta;
            if (val < 1) val = 1;
            el.value = val;
        }

        // Add to cart from Details
        document.querySelector('.add-cart-btn-details')?.addEventListener('click', function () {
            const id = this.dataset.id;
            const name = this.dataset.name;
            const price = this.dataset.price;
            const img = this.dataset.img;
            const qty = parseInt(document.getElementById('pQty').value) || 1;

            const formData = new FormData();
            formData.append('productId', id);
            formData.append('quantity', qty);

            fetch('/Cart/AddToCart', { method: 'POST', body: formData })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const badge = document.getElementById('cartBadge');
                        if (badge) badge.textContent = data.itemsCount;
                        if (window.pettiShowToast) {
                            window.pettiShowToast(name, `${(parseFloat(price) * qty).toFixed(2)} JOD`, img);
                        } else {
                            alert('Added to cart!');
                        }
                    }
                });
        });

        // Tabs Logic (Description & Reviews only)
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('text-berry', 'border-bottom', 'border-3', 'border-danger');
                    b.classList.add('text-muted');
                });
                this.classList.remove('text-muted');
                this.classList.add('text-berry', 'border-bottom', 'border-3', 'border-danger');

                document.querySelectorAll('.tab-pane-content').forEach(p => p.style.display = 'none');
                document.getElementById(this.dataset.target).style.display = 'block';
            });
        });

        // Star Picker Logic
        document.querySelectorAll('.p-star-item').forEach(star => {
            star.addEventListener('click', function () {
                const val = parseInt(this.dataset.val);
                document.getElementById('reviewRatingInput').value = val;
                document.querySelectorAll('.p-star-item').forEach((s, i) => {
                    s.style.color = (i < val) ? '#F59E0B' : '#E2E8F0';
                });
            });
        });

        // Submit Review AJAX
        async function submitProductReviewAjax(e) {
            e.preventDefault();
            const btn = document.getElementById('submitRevBtn');
            const errBox = document.getElementById('reviewErrorAlert');
            errBox.style.display = 'none';

            const form = document.getElementById('productReviewForm');
            const formData = new FormData(form);

            btn.disabled = true;
            btn.innerHTML = 'Submitting... <i class="fa-solid fa-spinner fa-spin ms-1"></i>';

            try {
                const res = await fetch('/Products/SubmitReview', { method: 'POST', body: formData });
                const data = await res.json();

                if (data.success) {
                    const modalEl = document.getElementById('productReviewModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    const emptyPrompt = document.getElementById('noReviewsPrompt');
                    if (emptyPrompt) emptyPrompt.remove();

                    let starsHtml = '';
                    for (let i = 1; i <= 5; i++) {
                        starsHtml += `<i class="fa-solid fa-star ${i <= data.rating ? "" : "text-muted opacity-25"}"></i>`;
                    }

                    const newReviewCard = `
                                <div class="p-3 bg-white rounded-4 border shadow-sm mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-sm"
                                                 style="width: 34px; height: 34px; background: linear-gradient(135deg, var(--berry), #BE123C); font-size: 0.85rem;">
                                                ${data.initial}
                                            </div>
                                            <div>
                                                <strong style="color:var(--ink); font-size:0.92rem;">${data.author}</strong>
                                                <span class="badge rounded-pill bg-success-subtle text-success border px-2 py-0 ms-1" style="font-size:0.65rem;">Verified Buyer</span>
                                            </div>
                                        </div>
                                        <div style="color: #F59E0B;" class="small">
                                            ${starsHtml}
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-1" style="line-height: 1.5;">${data.comment}</p>
                                    <span class="text-muted" style="font-size:0.75rem;">${data.date}</span>
                                </div>
                            `;

                    document.getElementById('reviewsListContainer').insertAdjacentHTML('afterbegin', newReviewCard);
                } else {
                    errBox.textContent = data.message || 'Error submitting review.';
                    errBox.style.display = 'block';
                }
            } catch (err) {
                errBox.textContent = 'Connection error. Please try again.';
                errBox.style.display = 'block';
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Submit Review <i class="fa-solid fa-paper-plane ms-1"></i>';
            }
        }
    </script>
}