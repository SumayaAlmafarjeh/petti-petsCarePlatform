@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password — Petti</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true">
</head>
<body>

    <div class="auth-shell">

        <div class="auth-visual">
            <div class="auth-visual-copy">
                <div class="cat-wrap">
                    <div class="cat-face">
                        <div class="cat-ear left"></div>
                        <div class="cat-ear right"></div>
                        <div class="cat-whiskers">
                            <span class="whisker l1"></span><span class="whisker l2"></span><span class="whisker l3"></span>
                            <span class="whisker r1"></span><span class="whisker r2"></span><span class="whisker r3"></span>
                        </div>
                        <div class="cat-eyes"><span class="cat-eye"></span><span class="cat-eye"></span></div>
                        <div class="cat-nose"></div>
                        <div class="cat-mouth"></div>
                    </div>
                </div>
                <h2>@(Model.EmailSent ? "Almost there" : "It happens to the best of us")</h2>
                <p>@(Model.EmailSent ? "Check your inbox for instructions to reset your password." : "Tell us the email on your account and we'll send a reset link.")</p>
            </div>
        </div>

        <div class="auth-card-wrap">
            <div class="auth-card">

                <a asp-controller="Home" asp-action="Index" class="petti-logo">
                    <img src="~/images/logoIcon.png" asp-append-version="true" alt="Petti Logo" class="site-logo">
                </a>

                @if (!Model.EmailSent)
                {
                    <h1>Reset your password</h1>
                    <p class="lead-auth">Enter your email and we'll send you a reset link.</p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2 small" role="alert"></div>

                        <label class="form-label-petti" asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" class="form-control-petti mb-2" placeholder="you@email.com" autocomplete="username" />
                        <span asp-validation-for="Input.Email" class="text-danger small d-block mb-3"></span>

                        <button type="submit" class="btn-petti btn-berry" style="width:100%;">Send Reset Link <i class="fa-solid fa-paper-plane ms-1"></i></button>
                    </form>

                    <p class="auth-foot-link mt-4 mb-0">Remembered it? <a asp-page="./Login">Back to sign in</a></p>
                }
                else
                {
                    <div class="text-center py-3">
                        <div style="font-size: 3rem; color: var(--royal); margin-bottom: 1rem;">
                            <i class="fa-solid fa-envelope-open-text"></i>
                        </div>
                        <h1>Check your inbox</h1>
                        <p class="lead-auth">We've sent password reset instructions to your email address.</p>
                        <a asp-page="./Login" class="btn-petti btn-royal-outline mt-3 w-100 justify-content-center text-decoration-none">Back to Sign In</a>
                    </div>
                }

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>