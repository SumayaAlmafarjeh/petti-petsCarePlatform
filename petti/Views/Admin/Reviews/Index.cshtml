@model IEnumerable<petti.Models.Review>
@{
    ViewData["Title"] = "Review Moderation";
    ViewData["HeaderTitle"] = "Review Moderation";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
        <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KPIs Row -->
<div class="row g-4 mb-4">
    <div class="col-sm-4">
        <div class="admin-panel p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">Awaiting Moderation</span>
                <span class="badge bg-warning-subtle text-warning p-2 rounded-3"><i class="fa-solid fa-hourglass-half"></i></span>
            </div>
            <h3 class="h4 mb-0 fw-bold" id="kpiPending">@ViewBag.PendingCount</h3>
            <span class="text-muted small">Needs admin review</span>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="admin-panel p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">Approved & Visible</span>
                <span class="badge bg-success-subtle text-success p-2 rounded-3"><i class="fa-solid fa-check"></i></span>
            </div>
            <h3 class="h4 mb-0 fw-bold" id="kpiApproved">@ViewBag.ApprovedCount</h3>
            <span class="text-muted small">Active on live store</span>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="admin-panel p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-muted small">Rejected</span>
                <span class="badge bg-danger-subtle text-danger p-2 rounded-3"><i class="fa-solid fa-ban"></i></span>
            </div>
            <h3 class="h4 mb-0 fw-bold" id="kpiRejected">@ViewBag.RejectedCount</h3>
            <span class="text-muted small">Hidden from store</span>
        </div>
    </div>
</div>

<div class="admin-panel">
    <!-- Filter Bar -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="d-flex flex-wrap gap-2 flex-grow-1" style="max-width: 600px;">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-sm btn-berry text-white fw-semibold px-3 review-tab-btn" data-status="Pending">Pending</button>
                <button type="button" class="btn btn-sm btn-light border fw-semibold px-3 review-tab-btn" data-status="Approved">Approved</button>
                <button type="button" class="btn btn-sm btn-light border fw-semibold px-3 review-tab-btn" data-status="Rejected">Rejected</button>
                <button type="button" class="btn btn-sm btn-light border fw-semibold px-3 review-tab-btn" data-status="all">All</button>
            </div>

            <select id="reviewTypeFilter" class="form-control-petti" style="max-width: 200px;">
                <option value="all">Products & Services</option>
                <option value="product">Products only</option>
                <option value="service">Services only</option>
            </select>
        </div>

        <span class="text-muted small" id="reviewCount">Showing 0 reviews</span>
    </div>

    <!-- Table -->
    <div style="overflow-x:auto;">
        <table class="table-petti w-100 align-middle mb-0" id="reviewsTable">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Reviewed Item</th>
                    <th>Rating</th>
                    <th style="min-width: 240px;">Comment</th>
                    <th>Status</th>
                    <th style="width: 130px;">Actions</th>
                </tr>
            </thead>
            <tbody id="reviewsBody">
                @foreach (var r in Model)
                {
                    var isProd = r.ProductId.HasValue;
                    var itemName = isProd ? (r.Product?.Name ?? "Product") : (r.Service?.Name ?? "Service");
                    var itemType = isProd ? "product" : "service";
                    var status = r.Status ?? "Pending";

                    var statusBadgeClass = status switch
                    {
                        "Approved" => "status-delivered",
                        "Rejected" => "badge rounded-pill bg-danger-subtle text-danger border px-3 py-1",
                        _ => "status-processing"
                    };

                    <tr class="admin-review-row"
                        data-id="@r.ReviewId"
                        data-status="@status"
                        data-type="@itemType">
                        <td>
                            <strong style="color:var(--ink);">@(r.Customer?.FullName ?? "Customer")</strong>
                            <div style="font-size:0.75rem; color:var(--ink-faint);">@r.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@itemName</div>
                            <span class="badge @(isProd ? "bg-primary-subtle text-primary" : "bg-info-subtle text-info") border px-2 py-0 small">
                                @(isProd ? "Product" : "Service")
                            </span>
                        </td>
                        <td>
                            <div class="text-sunbeam small">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fa-solid fa-star @(i <= r.Rating ? "" : "text-muted opacity-25")"></i>
                                }
                            </div>
                        </td>
                        <td>
                            <p class="mb-0 small text-muted" style="line-height:1.4;">@r.Comment</p>
                        </td>
                        <td>
                            <span class="status-badge @statusBadgeClass" id="status-badge-@r.ReviewId">@status</span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">
                                <!-- Approve -->
                                <button type="button" class="table-icon-btn text-success border-0 bg-transparent"
                                        onclick="moderateReview(@r.ReviewId, 'Approved')" title="Approve Review">
                                    <i class="fa-solid fa-check"></i>
                                </button>
                                <!-- Reject -->
                                <button type="button" class="table-icon-btn text-warning border-0 bg-transparent"
                                        onclick="moderateReview(@r.ReviewId, 'Rejected')" title="Reject Review">
                                    <i class="fa-solid fa-ban"></i>
                                </button>
                                <!-- Delete -->
                                <form asp-action="DeleteReview" asp-route-id="@r.ReviewId" method="post" class="d-inline" onsubmit="return confirm('Delete this review permanently?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="table-icon-btn text-danger border-0 bg-transparent" title="Delete Review">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Empty State -->
    <div id="reviewsEmpty" class="text-center p-5" style="display:none;">
        <i class="fa-solid fa-star-half-stroke text-muted mb-3" style="font-size: 2.5rem;"></i>
        <h5 class="fw-bold">Nothing to moderate here</h5>
        <p class="text-muted small mb-0">Reviews matching this filter will show up as customers submit them.</p>
    </div>

    <!-- Pagination Footer -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 pt-3 border-top mt-3" id="paginationWrapper">
        <div class="text-muted small" id="paginationInfo">Showing 0 to 0 of 0 entries</div>
        <div class="d-flex align-items-center gap-1" id="paginationControls"></div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const pageSize = 10;
        let currentPage = 1;
        let activeStatusTab = 'Pending';
        let visibleRows = [];

        const typeFilter = document.getElementById('reviewTypeFilter');
        const allRows = Array.from(document.querySelectorAll('.admin-review-row'));
        const paginationControls = document.getElementById('paginationControls');
        const paginationInfo = document.getElementById('paginationInfo');
        const paginationWrapper = document.getElementById('paginationWrapper');
        const emptyState = document.getElementById('reviewsEmpty');
        const reviewCountLabel = document.getElementById('reviewCount');

        function applyFilterAndPagination() {
            const type = typeFilter.value;

            visibleRows = allRows.filter(row => {
                const status = row.dataset.status;
                const rowType = row.dataset.type;

                const matchesStatus = (activeStatusTab === 'all' || status === activeStatusTab);
                const matchesType = (type === 'all' || rowType === type);

                return matchesStatus && matchesType;
            });

            const totalPages = Math.ceil(visibleRows.length / pageSize) || 1;
            if (currentPage > totalPages) currentPage = 1;

            allRows.forEach(r => r.style.display = 'none');

            if (visibleRows.length === 0) {
                emptyState.style.display = 'block';
                document.getElementById('reviewsTable').style.display = 'none';
            } else {
                emptyState.style.display = 'none';
                document.getElementById('reviewsTable').style.display = '';
                const start = (currentPage - 1) * pageSize;
                const end = start + pageSize;
                visibleRows.slice(start, end).forEach(r => r.style.display = '');
            }

            const startCount = visibleRows.length === 0 ? 0 : (currentPage - 1) * pageSize + 1;
            const endCount = Math.min(currentPage * pageSize, visibleRows.length);
            paginationInfo.textContent = `Showing ${startCount} to ${endCount} of ${visibleRows.length} entries`;
            reviewCountLabel.textContent = `${visibleRows.length} review${visibleRows.length === 1 ? '' : 's'}`;

            renderPaginationButtons(totalPages);
        }

        function renderPaginationButtons(totalPages) {
            paginationControls.innerHTML = '';

            if (visibleRows.length <= pageSize) {
                paginationWrapper.style.display = visibleRows.length === 0 ? 'none' : 'flex';
                return;
            } else {
                paginationWrapper.style.display = 'flex';
            }

            const prevBtn = document.createElement('button');
            prevBtn.type = 'button';
            prevBtn.className = `btn btn-sm btn-light border rounded-3 px-2 ${currentPage === 1 ? 'disabled opacity-50' : ''}`;
            prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left" style="font-size:0.75rem;"></i>';
            prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; applyFilterAndPagination(); } };
            paginationControls.appendChild(prevBtn);

            for (let i = 1; i <= totalPages; i++) {
                const pageBtn = document.createElement('button');
                pageBtn.type = 'button';
                const isActive = (i === currentPage);
                pageBtn.className = `btn btn-sm rounded-3 px-3 fw-semibold ${isActive ? 'btn-berry text-white' : 'btn-light border'}`;
                pageBtn.textContent = i;
                pageBtn.onclick = () => { currentPage = i; applyFilterAndPagination(); };
                paginationControls.appendChild(pageBtn);
            }

            const nextBtn = document.createElement('button');
            nextBtn.type = 'button';
            nextBtn.className = `btn btn-sm btn-light border rounded-3 px-2 ${currentPage === totalPages ? 'disabled opacity-50' : ''}`;
            nextBtn.innerHTML = '<i class="fa-solid fa-chevron-right" style="font-size:0.75rem;"></i>';
            nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; applyFilterAndPagination(); } };
            paginationControls.appendChild(nextBtn);
        }

        // Tabs Event
        document.querySelectorAll('.review-tab-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.review-tab-btn').forEach(b => {
                    b.classList.remove('btn-berry', 'text-white');
                    b.classList.add('btn-light', 'border');
                });
                this.classList.remove('btn-light', 'border');
                this.classList.add('btn-berry', 'text-white');

                activeStatusTab = this.dataset.status;
                currentPage = 1;
                applyFilterAndPagination();
            });
        });

        typeFilter.addEventListener('change', () => { currentPage = 1; applyFilterAndPagination(); });

        // Live Moderate Action via Ajax
        async function moderateReview(reviewId, newStatus) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('reviewId', reviewId);
            formData.append('status', newStatus);
            formData.append('__RequestVerificationToken', token);

            const res = await fetch('/Admin/ModerateReview', { method: 'POST', body: formData });
            const data = await res.json();

            if (data.success) {
                const row = document.querySelector(`.admin-review-row[data-id="${reviewId}"]`);
                if (row) {
                    row.dataset.status = newStatus;
                    const badge = document.getElementById(`status-badge-${reviewId}`);
                    badge.textContent = newStatus;
                    badge.className = 'status-badge ' + (newStatus === 'Approved' ? 'status-delivered' : newStatus === 'Rejected' ? 'badge rounded-pill bg-danger-subtle text-danger border px-3 py-1' : 'status-processing');
                }

                document.getElementById('kpiPending').textContent = data.pending;
                document.getElementById('kpiApproved').textContent = data.approved;
                document.getElementById('kpiRejected').textContent = data.rejected;

                applyFilterAndPagination();
            }
        }

        applyFilterAndPagination();
    </script>
}